# ── Database ──────────────────────────────────────────────
# Local (Docker): both URLs are the same.
DATABASE_URL="postgresql://erp:erp_dev_pw@127.0.0.1:5433/hosiery_erp?schema=public"
DIRECT_URL="postgresql://erp:erp_dev_pw@127.0.0.1:5433/hosiery_erp?schema=public"

# Production on Vercel + Supabase (Project → Connect → ORMs → Prisma):
#   DATABASE_URL = pooled "Transaction" connection (port 6543), used by the app:
#     postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Session"/direct connection (port 5432), used only by migrations:
#     postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Application ───────────────────────────────────────────
# Public base URL of the app (e.g. https://your-erp.vercel.app).
APP_URL="http://localhost:3000"

# Set to "true" only if you serve production over plain HTTP on a trusted LAN
# (the session cookie is otherwise marked Secure in production).
INSECURE_COOKIES="false"

# Max product image size in bytes (images are stored in the database).
UPLOAD_MAX_BYTES="2097152"

# ── Seed ──────────────────────────────────────────────────
# `npm run db:seed` creates the users with these passwords.
# For production set SEED_DEMO="false" (no demo data) and strong passwords (8+ chars).
SEED_DEMO="true"
SEED_ADMIN_PASSWORD="admin123"
SEED_STORE_PASSWORD="store123"
SEED_SALES_PASSWORD="sales123"
